{
  "name": "dsh-session-sync-flush",
  "version": "0.1.0",
  "description": "DSH 插件：关键会话事件后立即 flush 日志，减少崩溃时丢对话。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness"],
  "files": ["lib", "cordis.patch.yml"],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.1.5-rc.2 || ^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "^0.1.5-rc.2",
      "dshReleases": {
        "0.1.5-rc.2": "compatible"
      }
    }
  }
}
